@model ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
    NopHtml.SetActiveMenuItemSystemName("Local plugins");
}

<form asp-controller="FaqManagerAdmin" asp-action="Configure" method="post">
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                @await Component.InvokeAsync(typeof(StoreScopeConfigurationViewComponent))
                @await Component.InvokeAsync(typeof(SettingModeViewComponent))
                <div asp-validation-summary="All"></div>

                <nop-cards id="faqsettings-cards">
                    <div class="card card-default">
                        <div class="card-header">
                            <i class="fas fa-info"></i>@T("Plugins.Misc.FaqManager.Configuration.BlockTitle.Settings")
                        </div>
                        <div class="card-body">
                            <div class="form-group row">
                                <div class="col-md-3">
                                    <nop-override-store-checkbox asp-for="ShowFaqCount_OverrideForStore" asp-input="ShowFaqCount" asp-store-scope="@Model.ActiveStoreScopeConfiguration" />
                                    <nop-label asp-for="ShowFaqCount" />
                                </div>
                                <div class="col-md-9">
                                    <nop-editor asp-for="ShowFaqCount" />
                                    <span asp-validation-for="ShowFaqCount"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="offset-md-3 col-md-9">
                            <button type="submit" name="save" class="btn btn-primary">
                                <i class="far fa-floppy-disk"></i>
                                @T("Admin.Common.Save")
                            </button>
                        </div>
                    </div>
                </nop-cards>
            </div>
        </div>
    </section>
</form>