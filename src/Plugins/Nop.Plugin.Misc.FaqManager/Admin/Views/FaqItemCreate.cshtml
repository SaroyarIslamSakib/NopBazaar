@model FaqItemModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.FaqManager.FaqItems.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName(FaqManagerDefaults.FaqGroupsMenuSystemName);
}

<form asp-controller="FaqManagerAdmin" asp-action="FaqItemCreate" asp-route-faqGroupId="@Model.FaqGroupId" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.FaqManager.FaqItems.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="FaqGroupEdit" asp-route-id="@Model.FaqGroupId">@T("Plugins.Misc.FaqManager.FaqItems.BackToFaqGroup")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("~/Plugins/Misc.FaqManager/Admin/Views/_CreateOrUpdate.FaqItem.cshtml", Model)
</form>