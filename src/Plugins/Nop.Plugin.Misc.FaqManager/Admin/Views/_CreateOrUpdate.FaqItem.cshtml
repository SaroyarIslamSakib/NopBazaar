@model FaqItemModel

@{
    const string hideInfoBlockAttributeName = "FaqItemPage.HideInfoBlock";
    var customer = await workContext.GetCurrentCustomerAsync();
    var hideInfoBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideInfoBlockAttributeName);
}

<div asp-validation-summary="All"></div>
<input asp-for="Id" type="hidden" />
<input asp-for="FaqGroupId" type="hidden" />

<section class="content">
    <div class="container-fluid">
        <div class="form-horizontal">
            <nop-cards id="faqitem-cards">
                <nop-card asp-name="faqitem-info" asp-icon="fas fa-info" asp-title="@T("Admin.Common.Info")" asp-hide-block-attribute-name="@hideInfoBlockAttributeName" asp-hide="@hideInfoBlock">
                    <div class="card-body">
                        @(await Html.LocalizedEditorAsync<FaqItemModel, FaqItemModel.FaqItemLocalizedModel>("faqitem-localized",
@<div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="@Model.Locales[item].Question" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="@Model.Locales[item].Question" />
            <span asp-validation-for="@Model.Locales[item].Question"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="@Model.Locales[item].Answer" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="@Model.Locales[item].Answer" asp-template="Multiline" />
            <span asp-validation-for="@Model.Locales[item].Answer"></span>
        </div>
    </div>
    <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
</div>,
@<div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Question" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Question" asp-required="true" />
            <span asp-validation-for="Question"></span>
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-3">
            <nop-label asp-for="Answer" />
        </div>
        <div class="col-md-9">
            <nop-editor asp-for="Answer" asp-template="Multiline" asp-required="true" />
            <span asp-validation-for="Answer"></span>
        </div>
    </div>
</div>))
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="Published" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="Published" />
                                <span asp-validation-for="Published"></span>
                            </div>
                        </div>
                        <div class="form-group row">
                            <div class="col-md-3">
                                <nop-label asp-for="DisplayOrder" />
                            </div>
                            <div class="col-md-9">
                                <nop-editor asp-for="DisplayOrder" />
                                <span asp-validation-for="DisplayOrder"></span>
                            </div>
                        </div>
                    </div>
                </nop-card>
            </nop-cards>
        </div>
    </div>
</section>